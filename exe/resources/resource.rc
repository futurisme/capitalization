#include <windows.h>

#ifndef RT_MANIFEST
#define RT_MANIFEST 24
#endif

#ifndef VS_VERSION_INFO
#define VS_VERSION_INFO 1
#endif

1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 13,0,0,0
 PRODUCTVERSION 13,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "CapLab 13 Native Engineering"
            VALUE "FileDescription", "CapLab 13 Native Windows 11 Simulation Engine"
            VALUE "FileVersion", "13.0.0.0"
            VALUE "InternalName", "CapLab13Native"
            VALUE "OriginalFilename", "CapLab13Native.exe"
            VALUE "ProductName", "CapLab 13 · Simulasi Ekonomi & Konglomerasi 2.5D"
            VALUE "ProductVersion", "13.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
